# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored and must stay that way. Nothing in here should ever hold a
# real credential — this file is committed.
#
# On the server, .env lives beside docker-compose.yml; compose reads it and
# passes the variables into the backend container.

# ---------------------------------------------------------------- required
# The app refuses to start without these.

# Postgres connection string.
DATABASE_URL=postgresql://user:password@host:5432/edtech

# Signs and verifies login tokens. Any long random string; changing it logs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts. Optional, defaults to 7d.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- storage
# Cloudflare R2, where videos and documents are kept.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---------------------------------------------------------------- payments
# Razorpay. Leave both blank to disable paid enrolment — free courses still
# work, and the paid checkout returns a clear "not available" message rather
# than failing obscurely.
#
# The key id is public (the checkout widget needs it in the browser).
# The key secret signs payment verification and must never reach the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------- email
# Used for password reset codes. Leave blank and codes are printed to the
# backend log instead of being emailed — the reset flow still works end to end,
# which is useful before a mail provider is set up.
#
# Any SMTP provider works: Gmail, Brevo, Zoho, SendGrid.
#   port 587 -> STARTTLS
#   port 465 -> implicit TLS
# For Gmail, SMTP_PASS must be a 16-character App Password with 2-Step
# Verification enabled. The normal account password is rejected.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------------------------------------------------------------- runtime
NODE_ENV=production
PORT=3000

# Recommended: run the Node process in UTC.
#
# node-postgres serialises a JS Date to the Node process's local wall clock. A
# server in IST against a database in UTC therefore wrote timestamps 5.5 hours
# out, which is how course access expiries silently stopped expiring once
# before. Pinning both to UTC removes the class of bug.
TZ=UTC
